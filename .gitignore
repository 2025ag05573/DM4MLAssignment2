# --- data: MovieLens licence forbids redistribution; every file is regenerated by the pipeline
data/**
!data/*/
!data/*/.gitkeep

# --- trained models are reproducible from the pipeline (metadata is kept)
models/*.pkl

# --- experiment tracking store
mlruns/
mlartifacts/

# --- per-run logs (a reference run log is committed as reports/logs/reference_run.log)
reports/logs/pipeline.log

# --- python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/
